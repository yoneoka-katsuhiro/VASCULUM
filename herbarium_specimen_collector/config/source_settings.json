    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "TI is searched directly through the University of Tokyo fern type collection database.",
    "components": [
      {
        "component_name": "ti_type_database",
        "handler": "ti_type",
        "search_form_url": "https://umdb.um.u-tokyo.ac.jp/DShokubu/herbarium_ferns/en/Collection/search.php?-langTop=jp",
        "search_result_url": "https://umdb.um.u-tokyo.ac.jp/DShokubu/herbarium_ferns/en/Collection/searchresult.php?-langTop=jp",
        "request_delay_seconds": 2.0,
        "page_size": 25,
        "max_pages_per_name": 5,
        "image_variant": "2048",
        "exact_name_filter": true
      }
    ]
  },
  "tns": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "TNS is searched directly through the National Museum of Nature and Science WebMuseum specimen database for vascular plant specimens.",
    "components": [
      {
        "component_name": "tns_webmuseum_vascular",
        "handler": "tns_webmuseum",
        "search_url": "https://db.kahaku.go.jp/CrossSearch/list?secIdx=0&cls=top&pn={page}&chkCls=col_b1_01&c1_f={query}&c1_a=1&c1_l=1&dispnum={page_size}",
        "request_delay_seconds": 2.0,
        "page_size": 50,
        "max_pages_per_name": 5,
        "exact_name_filter": true,
        "media_size": "S",
        "media_suffix": "c2510"
      }
    ]
  },
  "tai": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "TAI is searched directly through Plants of Taiwan/TAI2 species pages when configured.",
    "components": [
      {
        "component_name": "tai2",
        "handler": "tai2",
        "request_delay_seconds": 2.0,
        "max_pages_per_name": 1,
        "exact_name_filter": true,
        "species_pages": {
          "Haplopteris mediosora": [
            "https://tai2.ntu.edu.tw/species/121%20003%2005%200",
            "https://tai2.ntu.edu.tw/species/121%20003%2003%200"
          ],
          "Vittaria mediosora": [
            "https://tai2.ntu.edu.tw/species/121%20003%2003%200"
          ]
        },
        "name_equivalents": {
          "Haplopteris mediosora": ["Haplopteris mediosora", "Vittaria mediosora"],
          "Vittaria mediosora": ["Vittaria mediosora"]
        }
      }
    ]
  },
  "taif": {
    "handler": "taif",
    "request_delay_seconds": 3.0,
    "image_delay_seconds": 3.0,
    "max_pages_per_name": 1,
    "normal_search_url": "https://taif.tfri.gov.tw/search/result.php?genus={genus}&species={species}&l=Eng&ol=1",
    "type_search_url": "https://taif.tfri.gov.tw/search/type/?keyword={query}&qf=keyword&l=Eng",
    "record_link_pattern": "(?:type/)?specimen\\.php\\?[^\\\"'<> ]+",
    "verify_tls": false,
    "image_verify_tls": false
  },
  "sing": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "SING is checked through its official Singapore Herbarium BRAHMS Online URL when reachable. The official BRAHMS URL currently redirects to the BRAHMS website list, so direct automated rows may be unavailable until SING republishes the public endpoint.",
    "components": [
      {
        "component_name": "sing_brahms",
        "handler": "brahms_bol",
        "base_url": "https://herbaria.plants.ox.ac.uk/bol/sing",
        "explore_url": "https://herbaria.plants.ox.ac.uk/bol/sing/Explore?genus={genus}&sp1={species}&view=images",
        "institution_code": "SING",
        "collection_code": "SING",
        "rights_holder": "Singapore Botanic Gardens Herbarium",
        "request_delay_seconds": 2.0
      }
    ]
  },
