      {
        "component_name": "naturalis_l",
        "handler": "naturalis",
        "api_url": "https://api.biodiversitydata.nl/v2/specimen/query/",
        "source_system_code": "BRAHMS",
        "request_delay_seconds": 1.5,
        "page_size": 100,
        "max_pages_per_name": 20,
        "exact_name_filter": true
