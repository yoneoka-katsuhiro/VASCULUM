    "components": [
      {
        "component_name": "rbge_e",
        "handler": "rbge",
        "search_url": "https://data.rbge.org.uk/search/herbarium/?barcode=&cfg=vherb.cfg&coll_name=&coll_num=&country_name=&family=&genus={genus}&keywords=&region=&species={species}",
