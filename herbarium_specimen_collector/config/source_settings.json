  },
  "download": {
    "minimum_image_width": 800,
    "minimum_image_height": 800,
    "minimum_image_bytes": 50000,
    "timeout_seconds": 60,
    "retry_count": 4,
    "retry_backoff_seconds": 5.0,
    "image_timeout_seconds": 20,
    "image_retry_count": 2,
    "image_retry_backoff_seconds": 2.0,
    "try_gbif_image_cache": true,
    "image_resolution_profiles": {
      "standard": {
        "max_image_dimension": 2400,
        "jpeg_quality": 88
      },
      "low": {
        "max_image_dimension": 1600,
        "jpeg_quality": 84
      }
    }
  }
