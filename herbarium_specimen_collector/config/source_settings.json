{
  "enabled_sources": [
    "gbif",
    "pteridoportal",
    "cvh",
    "cnh",
    "avh",
    "reflora",
    "kag",
    "bm",
    "b",
    "us",
    "ny",
    "l",
    "mo",
    "ucjeps",
    "mich",
    "f",
    "e",
    "flas",
    "ti",
    "tns",
    "tai",
    "taif",
    "sing",
    "bo"
  ],
  "continue_on_source_error": true,
  "gbif": {
    "handler": "gbif",
    "page_size": 100,
    "request_delay_seconds": 1.0,
    "image_delay_seconds": 1.0,
    "max_pages_per_name": 100,
    "occurrence_mode": "specimens",
    "coordinate_filter": "any",
    "media_policy": "best-per-occurrence"
  },
  "pteridoportal": {
    "handler": "symbiota",
    "base_url": "https://www.pteridoportal.org/portal",
    "search_url": "https://www.pteridoportal.org/portal/collections/list.php?db=all&taxa={query}&usethes=1&taxontype=2&showimages=1&page={page}",
    "request_delay_seconds": 2.0,
    "image_delay_seconds": 2.0,
    "max_pages_per_name": 5,
    "specimens_only": true,
    "exact_name_filter": false
  },
  "cvh": {
    "handler": "cvh",
    "request_delay_seconds": 4.0,
    "image_delay_seconds": 4.0,
    "page_size": 30,
    "max_pages_per_name": 50,
    "search_url": "https://www.cvh.ac.cn/spms/list.php?taxonName={query}&page={page}",
    "record_link_pattern": "detail\\.php\\?id=[A-Za-z0-9_-]+",
    "api_url": "https://www.cvh.ac.cn/controller/spms/list.php",
    "detail_api_url": "https://www.cvh.ac.cn/controller/spms/detail.php",
    "detail_url": "https://www.cvh.ac.cn/spms/detail.php?id={id}",
    "image_url": "https://image.cvh.ac.cn/files/l/{institutionCode}/{collectionCode}.jpg",
    "with_photo_only": true,
    "verify_tls": false,
    "image_verify_tls": false,
    "image_license": "http://creativecommons.org/licenses/by-nc-nd/4.0/"
  },
  "cnh": {
    "handler": "symbiota",
    "base_url": "https://neherbaria.org/portal",
    "search_url": "https://neherbaria.org/portal/collections/list.php?db=all&taxa={query}&usethes=1&taxontype=2&showimages=1&page={page}",
    "request_delay_seconds": 2.0,
    "image_delay_seconds": 2.0,
    "max_pages_per_name": 5,
    "specimens_only": true,
    "exact_name_filter": false
  },
  "avh": {
    "handler": "ala",
    "api_url": "https://api.ala.org.au/occurrences/occurrences/search",
    "record_url": "https://avh.ala.org.au/occurrences/{uuid}",
    "request_delay_seconds": 1.5,
    "image_delay_seconds": 1.5,
    "page_size": 100,
    "max_pages_per_name": 10,
    "specimens_only": true,
    "exact_name_filter": true
  },
  "reflora": {
    "handler": "jabot",
    "api_url": "https://servicos.jbrj.gov.br/v2/jabot/occurrence/{species}/{genus}/{family}",
    "request_delay_seconds": 1.5,
    "image_delay_seconds": 1.5
  },
  "kag": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "KAG is searched directly through the Kagoshima University Museum Vascular Plants Database.",
    "components": [
      {
        "component_name": "kag_vascular_plants",
        "handler": "kag",
        "search_url": "https://dbs.kaum.kagoshima-u.ac.jp/musedb/s_plant/s_plant.php",
        "request_delay_seconds": 2.0,
        "page_size": 50,
        "max_pages_per_name": 20,
        "exact_name_filter": true,
        "rights_holder": "The Kagoshima University Museum",
        "image_license": "rights_reserved",
        "rights_note": "KAG herbarium page states personal use is permitted; contact Kagoshima University Museum for broad redistribution or commercial use."
      }
    ]
  },
  "bm": {
    "handler": "nhm",
    "api_url": "https://data.nhm.ac.uk/api/3/action/datastore_search",
    "resource_id": "05ff2255-c38a-40c9-b657-4ccb55ab2feb",
    "record_url": "https://data.nhm.ac.uk/object/{id}",
    "request_delay_seconds": 1.5,
    "image_delay_seconds": 1.5,
    "page_size": 100,
    "max_pages_per_name": 20,
    "exact_name_filter": true
  },
  "b": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "B is searched directly through the public JACQ/BGBM JSON API.",
    "components": [
      {
        "component_name": "jacq_b",
        "handler": "jacq",
        "api_url": "https://api.jacq.org/v1/objects/specimens",
        "image_list_url": "https://api.jacq.org/v1/images/list/{specimen_id}",
        "institution_codes": ["B"],
        "request_delay_seconds": 1.5,
        "page_size": 50,
        "max_pages_per_name": 20,
        "with_images_only": true,
        "preferred_image_size": "europeana",
        "exact_name_filter": true
      }
    ]
  },
  "us": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "US is searched through the public NMNH Botany Collections JSON search and PteridoPortal.",
    "components": [
      {
        "component_name": "nmnh_us",
        "handler": "nmnh",
        "search_page_url": "https://collections.nmnh.si.edu/search/botany/",
        "api_url": "https://collections.nmnh.si.edu/search/botany/search.php",
        "request_delay_seconds": 1.5,
        "page_size": 10,
        "max_pages_per_name": 20,
        "image_width": 1600,
        "exact_name_filter": true
      },
      {
        "component_name": "pteridoportal_us",
        "handler": "symbiota",
        "base_url": "https://www.pteridoportal.org/portal",
        "search_url": "https://www.pteridoportal.org/portal/collections/list.php?db=all&taxa={query}&usethes=1&taxontype=2&showimages=1&page={page}",
        "institution_codes": ["US", "USNM"],
        "request_delay_seconds": 2.0,
        "max_pages_per_name": 5,
        "specimens_only": true,
        "exact_name_filter": false
      }
    ]
  },
  "ny": {
    "handler": "multi",
    "image_delay_seconds": 1.5,
    "source_note": "NYBG Virtual Herbarium was checked for direct public access, but scripted result access currently requires Cloudflare Turnstile human verification. NY is searched through PteridoPortal where available.",
