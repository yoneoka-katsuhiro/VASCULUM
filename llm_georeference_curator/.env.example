# Copy to .env and fill values that apply to your environment.
# Never commit .env.

# Default provider for personal high-quality verification.
# Uses `codex login` / `codex login status`, not OPENAI_API_KEY.
CODEX_MODEL_CANDIDATES=gpt-6.1-sol,gpt-5.5,gpt-5.6-sol
LLM_REASONING_EFFORT=medium
# Label reading defaults to the research model, with no web search.
# Optional after comparing difficult labels against a trusted transcription:
# LLM_LABEL_MODEL=gpt-6.1-terra
LLM_LABEL_REASONING_EFFORT=medium

# Optional geospatial refinement service overrides.
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter
OPEN_METEO_ELEVATION_ENDPOINT=https://api.open-meteo.com/v1/elevation
# CLI default: live multilingual web research for locality evidence.

# Optional OpenAI Responses API provider.
OPENAI_API_KEY=
OPENAI_MODEL_CANDIDATES=gpt-6.1-sol,gpt-5.5,gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium

# Optional Opus-style local CLI provider.
OPUS_MODEL_CANDIDATES=opus5

# Optional generic LLM provider command. The command must return JSON on stdout.
# The prompt is sent on stdin unless the command contains {prompt_file}.
# Placeholders: {model}, {prompt_file}, {image_paths}
# Example:
# LLM_COMMAND="opus5 --model {model} --json"
LLM_COMMAND=
